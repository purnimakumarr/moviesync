# Postgres connection string. Docker Compose overrides this with its own database.
DATABASE_URL=postgresql://user:password@localhost:5432/moviesync
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Auth0 / OIDC
OAUTH_ISSUER=https://your-tenant.auth0.com/
OAUTH_AUDIENCE=https://your-api-identifier
OAUTH_JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json
# Same value as VITE_OAUTH_CLIENT_ID; used to verify ID tokens.
OAUTH_CLIENT_ID=

# TMDB (https://www.themoviedb.org/settings/api) - v3 API key
TMDB_URL=https://api.themoviedb.org
TMDB_API_KEY=

IPAPI_URL=

BACKEND_DEV=http://localhost:80
BACKEND_PROD=
FRONTEND_URL_DEV=http://localhost:5173
FRONTEND_URL_PROD=

# Key for pgp_sym_encrypt on profile fields.
ENCRYPTION_KEY=
# RSA key pair for request/response payload encryption (PEM, quoted, multi-line allowed).
RSA_PUBLIC_KEY_FE=
RSA_PRIVATE_KEY_BE=
